#include <stdio.h>

int main() {
    char str[] = "swiss";
    int count[256] = {0};

    for(int i=0; str[i]; i++)
        count[str[i]]++;

    for(int i=0; str[i]; i++) {
        if(count[str[i]] == 1) {
            printf("First Non-Repeating Character: %c", str[i]);
            break;
        }
    }

    return 0;
}
