#include <stdio.h>
#include <string.h>

int main() {
    char str[3][20] = {"flower", "flow", "flight"};

    int i = 0;

    while(1) {
        char c = str[0][i];

        if(c == '\0')
            break;

        for(int j = 1; j < 3; j++) {
            if(str[j][i] != c) {
                goto end;
            }
        }

        printf("%c", c);
        i++;
    }

end:
    return 0;
}
