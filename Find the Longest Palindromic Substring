#include <stdio.h>
#include <string.h>

void longestPalindrome(char str[]) {
    int n = strlen(str);
    int start = 0, maxLen = 1;

    for(int i = 0; i < n; i++) {

        int l = i, r = i;
        while(l >= 0 && r < n && str[l] == str[r]) {
            if(r - l + 1 > maxLen) {
                start = l;
                maxLen = r - l + 1;
            }
            l--;
            r++;
        }

        l = i;
        r = i + 1;
        while(l >= 0 && r < n && str[l] == str[r]) {
            if(r - l + 1 > maxLen) {
                start = l;
                maxLen = r - l + 1;
            }
            l--;
            r++;
        }
    }

    printf("Longest Palindrome: ");
    for(int i = start; i < start + maxLen; i++)
        printf("%c", str[i]);
}

int main() {
    char str[] = "babad";
    longestPalindrome(str);
    return 0;
}
