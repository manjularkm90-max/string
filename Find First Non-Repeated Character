#include <stdio.h>

int main() {
    char str[] = "swiss";
    int freq[256] = {0};

    for(int i = 0; str[i]; i++)
        freq[str[i]]++;

    for(int i = 0; str[i]; i++) {
        if(freq[str[i]] == 1) {
            printf("First Non-Repeated Character: %c", str[i]);
            break;
        }
    }

    return 0;
}
